# ============================================================
# Assay — copy to backend/.env and adjust.
# Nothing is required: Assay starts clean and runs static analysis
# only until an LLM is configured (here or in Settings in the UI).
# ============================================================

# --- Web server -------------------------------------------------
ASSAY_HOST=127.0.0.1          # 0.0.0.0 on a shared server — then ALWAYS set ASSAY_AUTH_TOKEN
ASSAY_PORT=3101
ASSAY_AUTH_TOKEN=             # shared secret required by the UI/API (empty = no auth, local use only)
ASSAY_ALLOWED_ROOTS=          # e.g. D:\repos;E:\mcp  or  /srv/repos,/data/mcp — folders "Local path" audits may read
ASSAY_DATA_DIR=               # default: backend/data

# --- LLM (OpenAI-compatible) — can also be set in the UI ------------
ASSAY_LLM_BASE_URL=           # http://llm.corp.local:8000/v1  ·  http://localhost:11434/v1 (Ollama)
ASSAY_LLM_API_KEY=
ASSAY_LLM_MODEL=              # e.g. qwen2.5-coder:32b, llama-3.3-70b-instruct, gpt-4.1
ASSAY_LLM_CONTEXT_WINDOW=16384
ASSAY_LLM_MAX_OUTPUT_TOKENS=1800
ASSAY_LLM_TIMEOUT_S=180
ASSAY_LLM_MAX_CONCURRENCY=2
ASSAY_LLM_VERIFY_TLS=true
ASSAY_LLM_CA_BUNDLE=          # corporate CA bundle (PEM) for an internal PKI

# --- Engine -----------------------------------------------------------
ASSAY_MAX_PARALLEL_AUDITS=2
ASSAY_SCANNER_TIMEOUT_S=300
ASSAY_SEMGREP_CONFIG=auto     # air-gapped: path to a local semgrep rules folder
ASSAY_POLICY_FILE=            # YAML overriding thresholds/weights (see examples/policy.example.yaml)
ASSAY_CUSTOM_RULES_DIR=       # default: <data_dir>/rules  (see examples/custom-rules.example.yaml)
ASSAY_MAX_UPLOAD_MB=500
ASSAY_KEEP_WORKSPACES=false
